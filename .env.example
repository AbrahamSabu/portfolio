# Server
PORT=8080
HOST=127.0.0.1
# How often the server pushes batched updates to browsers (ms)
TICK_MS=1000

# Which feeds run: sim, opensky, adsblol, or a comma-separated mix. The
# simulator is the default so the demo works offline. opensky shows real
# aircraft; adsblol adds a second ADS-B network that fills in what OpenSky
# misses where you're zoomed in (same aircraft merge into one track); with
# sim too, real and invented traffic share the map.
FEEDS=sim
# The area every feed covers (the simulator's geography, live feeds' bounding box)
SCENARIO=english-channel

# Simulator
# Same seed = same traffic every run. Remove for a different picture each time.
SIM_SEED=42

# OpenSky Network (live aircraft). Works anonymously; an account raises the
# daily credit budget from 400 to 4,000. Create API client credentials at
# https://opensky-network.org (Account > API client) and set both values.
# OPENSKY_CLIENT_ID=
# OPENSKY_CLIENT_SECRET=
# Area to poll: scenario (default, 1 credit a poll for the Channel), world
# (every aircraft OpenSky sees, about 7,000+ at once, 4 credits a poll: roughly
# 1.7 h of viewing a day anonymously, 16.7 h with an account at 60 s), or
# viewport (anywhere in the world, but only what browsers are looking at:
# 1 credit a poll zoomed in to a region, 4 zoomed out to the world).
# OPENSKY_AREA=scenario
# REST API base. Leave unset for OpenSky itself; set it to use a proxy, or a
# local stub to rehearse failures (429s, outages) without spending credits.
# OPENSKY_API_URL=https://opensky-network.org/api
# Seconds between polls. Default 60 anonymous (credits last ~6.7 h a day),
# 15 with an account (~16.7 h). Minimum 10 anonymous, 5 with an account.
# OPENSKY_POLL_S=60

# adsb.lol (second ADS-B network; free, no key, data under the ODbL licence).
# It only answers point-and-radius queries, so it covers views up to about a
# region and stands aside when zoomed out further. Seconds between polls:
# ADSBLOL_POLL_S=30
# ADSBLOL_API_URL=https://api.adsb.lol

# Client (read by Vite at build/dev time)
# VITE_MAP_STYLE_URL=https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json
# Use "offline" for a plain background with no basemap tiles.
# VITE_WS_URL=ws://localhost:8080/ws

# Server
PORT=8080
HOST=127.0.0.1
# How often the server pushes batched updates to browsers (ms)
TICK_MS=1000
# Where the live picture is saved every 30 s, so a restart doesn't open on an
# empty map (ships can't be fetched again; they reappear only as they report).
# Default ../.cache/picture.json from server/, i.e. .cache/ in the repo. "off" keeps nothing.
# PICTURE_FILE=off

# Which feeds run: sim, opensky, adsblol, ais, or a comma-separated mix. The
# default is live aircraft from adsb.lol (free, no key) and live ships from
# AISStream (free key, below). sim is the offline simulator. opensky shows real
# aircraft; adsblol adds a second ADS-B network that fills in what OpenSky
# misses where you're zoomed in (same aircraft merge into one track); ais
# shows real ships from AISStream; with sim too, real and invented traffic
# share the map.
FEEDS=adsblol,ais
# The area every feed covers: cork (default, live feeds only) or
# english-channel (the only area the simulator has traffic for, so use it with sim)
SCENARIO=cork

# Simulator
# Same seed = same traffic every run. Remove for a different picture each time.
SIM_SEED=42

# OpenSky Network (live aircraft). Works anonymously; an account raises the
# daily credit budget from 400 to 4,000. Create API client credentials at
# https://opensky-network.org (Account > API client) and set both values.
# OPENSKY_CLIENT_ID=
# OPENSKY_CLIENT_SECRET=
# Area to poll: scenario (default, 1 credit a poll for the Channel), world
# (every aircraft OpenSky sees, about 7,000+ at once, 4 credits a poll: roughly
# 1.7 h of viewing a day anonymously, 16.7 h with an account at 60 s), or
# viewport (anywhere in the world, but only what browsers are looking at:
# 1 credit a poll zoomed in to a region, 4 zoomed out to the world).
# OPENSKY_AREA=scenario
# REST API base. Leave unset for OpenSky itself; set it to use a proxy, or a
# local stub to rehearse failures (429s, outages) without spending credits.
# OPENSKY_API_URL=https://opensky-network.org/api
# Seconds between polls. Default 60 anonymous (credits last ~6.7 h a day),
# 15 with an account (~16.7 h). Minimum 10 anonymous, 5 with an account.
# OPENSKY_POLL_S=60

# adsb.lol (second ADS-B network; free, no key, data under the ODbL licence).
# It only answers point-and-radius queries, so it covers views up to about a
# region and stands aside when zoomed out further. It always polls the
# scenario's area, even with nobody watching, so the map is full the moment a
# page opens. Seconds between polls while someone watches, and while nobody does:
# ADSBLOL_POLL_S=10
# ADSBLOL_WARM_POLL_S=30
# ADSBLOL_API_URL=https://api.adsb.lol

# AISStream.io (live ships, FEEDS=ais). Free: sign in at https://aisstream.io
# and create a key on the Account page. Keep it here, server side only;
# AISStream doesn't allow browsers to connect directly. Without a key the
# feed only reports that it's missing. One key allows 3 connections at once,
# so a dev server and a production server can run side by side.
# AISSTREAM_API_KEY=
# Area to stream: scenario (default), world (every ship AISStream's
# receivers hear: tens of thousands, mostly coastal), or viewport (only what
# browsers are looking at; a pan updates the subscription on the open
# connection, and ships appear as they next report).
# AIS_AREA=scenario
# Stream URL. Leave unset for AISStream itself; set it to a local stub to
# rehearse failures without using a connection.
# AISSTREAM_URL=wss://stream.aisstream.io/v0/stream

# Client (read by Vite at build/dev time)
# VITE_MAP_STYLE_URL=https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json
# Use "offline" for a plain background with no basemap tiles.
# VITE_WS_URL=ws://localhost:8080/ws

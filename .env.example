# Server
PORT=8080
HOST=127.0.0.1
# How often the server pushes batched updates to browsers (ms)
TICK_MS=1000

# Which feeds run: sim, or a comma-separated list. The simulator is the
# default so the demo works offline.
FEEDS=sim
# The area every feed covers (the simulator's geography, live feeds' bounding box)
SCENARIO=english-channel

# Simulator
# Same seed = same traffic every run. Remove for a different picture each time.
SIM_SEED=42

# Client (read by Vite at build/dev time)
# VITE_MAP_STYLE_URL=https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json
# Use "offline" for a plain background with no basemap tiles.
# VITE_WS_URL=ws://localhost:8080/ws
